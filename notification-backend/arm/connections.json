{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account used by the Azure Tables and Azure Queues connections"
      }
    },

    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure location where the connections are created"
      }
    }
  },

  "resources": [

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "azuretables-1",
      "location": "[parameters('location')]",

      "properties": {
        "displayName": "azuretables-1",

        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuretables')]"
        },

        "parameterValues": {
          "storageaccount": "[parameters('storageAccountName')]",

          "sharedkey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value]",

          "privacySetting": "None"
        }
      }
    },

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "azurequeues-1",
      "location": "[parameters('location')]",

      "properties": {
        "displayName": "azurequeues-1",

        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azurequeues')]"
        },

        "parameterValues": {
          "storageaccount": "[parameters('storageAccountName')]",

          "sharedkey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value]"
        }
      }
    },

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "sharepointonline-1",
      "location": "[parameters('location')]",

      "properties": {
        "displayName": "sharepointonline-1",

        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sharepointonline')]"
        }
      }
    },

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "office365-1",
      "location": "[parameters('location')]",

      "properties": {
        "displayName": "office365-1",

        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        }
      }
    },

    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "teams-1",
      "location": "[parameters('location')]",

      "properties": {
        "displayName": "teams-1",

        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
        }
      }
    }

  ]
}